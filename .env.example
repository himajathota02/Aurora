# Required for shared content and uploaded cassette audio. Apply supabase/schema.sql to create the tables and Storage bucket.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Local demonstration mode only. Keep this server-only and set it in .env.local.
# Local edits live in the current browser's localStorage; they are not shared.
AURORA_ADMIN_PASSWORD=choose-a-long-private-password
